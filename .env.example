# Copy to .env for local development, then start with: node --env-file=.env server.mjs
# Use a unique secret of at least 12 characters. Never commit the actual .env file.
ADMIN_PASSWORD=replace-with-a-unique-secret-at-least-12-characters
HOST=127.0.0.1
PORT=4173
# In production, set the exact HTTPS origin seen by visitors (no trailing slash).
# PUBLIC_ORIGIN=https://wall.example.org
# DATA_DIR=/var/lib/protest-wall
